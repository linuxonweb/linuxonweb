 "abi": {
  "syscalls": {
   "0x6a470001": "gpu_hostcall(op,a0..a4) -> >=0 | -errno",
   "0x6a470002": "gpu_hostcall_stats(u32 out[11]) -> 0 | -EFAULT (local)",
   "0x6a470003": "gpu_hostcall_control(cmd,arg), test hooks, -EPERM unless enabled"
  },
  "ops": {
   "1": "ECHO(value)",
   "2": "CHECKSUM(ptr,len,out_u32) FNV-1a-32",
   "3": "FILL(ptr,len,seed)",
   "4": "ADAPTER_INFO(out,cap,len_out) JSON",
   "5": "WRITEBUFFER_PROBE(src,len,out,cap,len_out) JSON",
   "6": "SLEEP(ms<=10000) async",
   "0x100": "TEST_HANG",
   "0x101": "TEST_CLOSE",
   "0x102": "TEST_TERMINATE"
  },
  "control": {
   "1": "RESPAWN",
   "2": "SET_STALL_MS(100..60000)"
  },
  "statsWords": [
   "version",
   "owner_state",
   "owner_gen",
   "slot",
   "heartbeat",
   "calls",
   "dead_reason",
   "flags",
   "thread_calls",
   "stall_ms",
   "thread_yields"
  ],
  "errors": {
   "ENOSYS": "no hub / op 0",
   "EBUSY": "re-entry from signal handler during own call",
   "ENODEV": "owner dead, request not taken",
   "EIO": "owner lost after taking request",
   "EAGAIN": "no free slot (256)",
   "EFAULT": "NULL/out-of-range/crossing-end pointer, incl. outputs; memory re-read per access",
   "EINVAL": "len>256MiB, negative len, unknown op, sleep>10s, odd writeBuffer len, bad control",
   "ENOSPC": "output too small (len_out = needed)",
   "EPERM": "test hooks disabled",
   "ETIMEDOUT": "respawn timeout"
  },
  "hub": "SharedArrayBuffer; header words 0-11 (magic GPH1, owner state/gen, heartbeat, doorbell, flags, next gen, dead reason, stall ms, startup ms, calls, tokens), pending bitmap 16-23, 256 slots x 16 words from word 32 (token,state,seq,op,gen,args[5],result,result2)",
  "slotState": "(seq << 2) | state; seq 30-bit per-slot, never 0; owner completes by exact BUSY->DONE CAS"
 },
 "concurrencyDesign": [
  "one slot per guest thread, claimed by CAS at first call, released at worker_exit",
  "owner waits on doorbell with Atomics.waitAsync and serves slots concurrently",
  "per-process WebAssembly.Memory relayed to owner once per slot",
  "cooperative caller wait: 1 ms pure Atomics.wait, then 1 ms slices alternating with sched_yield(124) kernel entry so the vCPU keeps interrupts, scheduling, signals and exit",
  "unwinding/exiting call abandons its slot; stale completions rejected by seq"
 ],
 "ownerLoss": [
  "heartbeat every 50 ms; caller marks owner dead after stall_ms (default 3000, test 1000) without heartbeat and asks page to terminate it",
  "page marks dead on Worker error, terminate, machine close",
  "taken request -> -EIO, untaken -> -ENODEV, later calls -ENODEV immediately",
  "no automatic respawn; test hook CTL_RESPAWN only"
 ],
