diff --git a/arch/wasm/include/asm/uaccess.h b/arch/wasm/include/asm/uaccess.h
new file mode 100644
--- /dev/null
+++ b/arch/wasm/include/asm/uaccess.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Compile-only user-copy stubs; browser memory protection is undefined. */
+#ifndef _ASM_WASM_UACCESS_H
+#define _ASM_WASM_UACCESS_H
+
+#include <linux/string.h>
+#include <asm-generic/access_ok.h>
+
+static inline unsigned long raw_copy_to_user(void __user *to,
+        const void *from, unsigned long n)
+{
+    memcpy((void __force *)to, from, n);
+    return 0;
+}
+static inline unsigned long raw_copy_from_user(void *to,
+        const void __user *from, unsigned long n)
+{
+    memcpy(to, (const void __force *)from, n);
+    return 0;
+}
+#include <asm-generic/uaccess.h>
+
+#endif /* _ASM_WASM_UACCESS_H */

