+// e.g. in self-hosted ArrayIteratorNext) unimplemented, as before; default on.
+static bool PblForOfIcOn() {
+  static const bool on = [] {
+    const char* e = getenv("PBL_FOROF_IC");
+    return !(e && e[0] == '0' && e[1] == '\0');
+  }();
+  return on;
+}
