{
  "name": "linuxonweb-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "stage": "node stage-assets.mjs",
    "dev": "npm run stage && wrangler dev --port 4183",
    "build": "npm run stage && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run stage && wrangler deploy",
    "test": "node --test *.test.mjs"
  },
  "devDependencies": { "wrangler": "4.141.0" }
}
