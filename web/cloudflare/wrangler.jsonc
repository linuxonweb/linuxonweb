{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linuxonweb",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
