+struct WasmMixedSignature { uint8_t count; uint32_t types; const uintptr_t* table; };
+static const WasmMixedSignature kWasmMixedSignatures[] = {
+  {12, 0x400, kWasmTransferInit},
+  {14, 0x100, kWasmTransferContext},
+  {6, 0x550, kWasmProgress64},
+  {4, 0x10, kWasmDataAvailable},
