+// WebAssembly requires exact call signatures. Keep a bounded set of typed
+// mixed-width signatures for XPIDL transfer/stream callbacks and scalar calls.
+// This preserves full 64-bit progress, offsets and PRTime values; unsupported
+// signatures still fail rather than truncating values or reporting success.
+template <typename T> static uint64_t WasmBits(T value) {
+  if constexpr (std::is_same_v<T, float>) {
+    uint32_t bits; memcpy(&bits, &value, sizeof(bits)); return bits;
+  } else { return uint64_t(value); }
+}
+template <typename T> static T WasmValue(uint64_t bits) {
+  if constexpr (std::is_same_v<T, float>) {
+    uint32_t word = uint32_t(bits); float value;
+    memcpy(&value, &word, sizeof(value)); return value;
+  } else { return T(bits); }
+}
+static uint32_t WasmTag(const nsXPTType& type) {
+  if (type == nsXPTType::T_I64 || type == nsXPTType::T_U64) return 1;
+  if (type == nsXPTType::T_FLOAT) return 2;
+  if (type == nsXPTType::T_DOUBLE) return 3;
+  return 0;
+}
+template <uint32_t MethodIndex, typename... Args>
+static nsresult WasmStubMixed(nsXPTCStubBase* self, Args... values) {
+  const nsXPTMethodInfo* info = nullptr;
+  if (NS_FAILED(self->mEntry->GetMethodInfo(MethodIndex, &info)) || !info ||
+      info->ParamCount() != sizeof...(Args)) return NS_ERROR_FAILURE;
+  uint64_t args[] = {WasmBits(values)...};
+  nsXPTCMiniVariant params[sizeof...(Args)]{};
+  for (uint32_t i = 0; i < sizeof...(Args); ++i) {
+    const auto& param = info->Param(i);
+    const auto& type = param.GetType();
+    if (param.IsOut() || !type.IsArithmetic()) {
+      params[i].val.p = reinterpret_cast<void*>(uintptr_t(args[i]));
+    } else {
+      switch (type) {
+        case nsXPTType::T_I8: params[i].val.i8 = int8_t(args[i]); break;
+        case nsXPTType::T_I16: params[i].val.i16 = int16_t(args[i]); break;
+        case nsXPTType::T_I32: params[i].val.i32 = int32_t(args[i]); break;
+        case nsXPTType::T_U8: params[i].val.u8 = uint8_t(args[i]); break;
+        case nsXPTType::T_U16: params[i].val.u16 = uint16_t(args[i]); break;
+        case nsXPTType::T_U32: params[i].val.u32 = uint32_t(args[i]); break;
+        case nsXPTType::T_BOOL: params[i].val.b = bool(args[i]); break;
+        case nsXPTType::T_CHAR: params[i].val.c = char(args[i]); break;
+        case nsXPTType::T_WCHAR: params[i].val.wc = char16_t(args[i]); break;
+        case nsXPTType::T_I64: params[i].val.i64 = int64_t(args[i]); break;
+        case nsXPTType::T_U64: params[i].val.u64 = args[i]; break;
+        case nsXPTType::T_FLOAT: params[i].val.f = WasmValue<float>(args[i]); break;
+        default: return NS_ERROR_NOT_IMPLEMENTED;
+      }
+    }
+  }
+  return self->mOuter->CallMethod(MethodIndex, info, params);
+}
