+static const uintptr_t* WasmMixedTable(const nsXPTMethodInfo& info) {
+  if (info.ParamCount() > 16 || info.WantsContext() || info.WantsOptArgc()) return nullptr;
+  uint32_t types = 0;
+  for (uint8_t i = 0; i < info.ParamCount(); ++i) {
+    const auto& param = info.Param(i);
+    if (!param.IsOut() && param.GetType().IsArithmetic())
+      types |= WasmTag(param.GetType()) << (2 * i);
+  }
+  for (const auto& signature : kWasmMixedSignatures)
+    if (signature.count == info.ParamCount() && signature.types == types) return signature.table;
+  return nullptr;
+}
+template <typename... Args, size_t... I>
+static nsresult WasmInvokeMixed(uintptr_t method, nsISupports* that,
+                               const uint64_t* args, std::index_sequence<I...>) {
+  return reinterpret_cast<nsresult (*)(nsISupports*, Args...)>(method)(
+      that, WasmValue<Args>(args[I])...);
+}
+static nsresult WasmInvokeMixedSignature(uintptr_t method, nsISupports* that,
+                                        uint32_t count, uint32_t types,
+                                        const uint64_t* args) {
+  if (count == 12 && types == 0x400)
+    return WasmInvokeMixed<uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uint64_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t>(method, that, args, std::make_index_sequence<12>{});
+  if (count == 14 && types == 0x100)
+    return WasmInvokeMixed<uintptr_t, uintptr_t, uintptr_t, uintptr_t, uint64_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t, uintptr_t>(method, that, args, std::make_index_sequence<14>{});
+  if (count == 6 && types == 0x550)
+    return WasmInvokeMixed<uintptr_t, uintptr_t, uint64_t, uint64_t, uint64_t, uint64_t>(method, that, args, std::make_index_sequence<6>{});
+  if (count == 4 && types == 0x10)
+    return WasmInvokeMixed<uintptr_t, uintptr_t, uint64_t, uintptr_t>(method, that, args, std::make_index_sequence<4>{});
+  if (count == 3 && types == 0x14)
+    return WasmInvokeMixed<uintptr_t, uint64_t, uint64_t>(method, that, args, std::make_index_sequence<3>{});
+  if (count == 2 && types == 0x4)
+    return WasmInvokeMixed<uintptr_t, uint64_t>(method, that, args, std::make_index_sequence<2>{});
+  if (count == 1 && types == 0x1)
+    return WasmInvokeMixed<uint64_t>(method, that, args, std::make_index_sequence<1>{});
+  if (count == 3 && types == 0x8)
+    return WasmInvokeMixed<uintptr_t, float, uintptr_t>(method, that, args, std::make_index_sequence<3>{});
+  if (count == 4 && types == 0x8)
+    return WasmInvokeMixed<uintptr_t, float, uintptr_t, uintptr_t>(method, that, args, std::make_index_sequence<4>{});
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
