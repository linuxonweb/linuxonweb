--- a/security/manager/ssl/nsNSSComponent.cpp
+++ b/security/manager/ssl/nsNSSComponent.cpp
@@ -71,6 +71,7 @@
 #include "nss.h"
 #include "p12plcy.h"
 #include "pk11pub.h"
+#include "pkcs11n.h"
 #include "prmem.h"
 #include "secerr.h"
 #include "secmod.h"
@@ -779,6 +780,115 @@
       return NS_OK;
     }
   }
+#ifdef __wasm__
+  // Static Wasm builds cannot dlopen CKBI. Complete the shipped profile's
+  // trust bootstrap after interrupted starts; normal verification still runs.
+  UniqueCERTCertList certs(PK11_ListCerts(PK11CertListUnique, nullptr));
+  unsigned certCount = 0;
+  unsigned trustReadable = 0;
+  unsigned sslTrusted = 0;
+  if (certs) {
+    for (CERTCertListNode* node = CERT_LIST_HEAD(certs.get());
+         !CERT_LIST_END(node, certs.get()); node = CERT_LIST_NEXT(node)) {
+      ++certCount;
+      CERTCertTrust trust = {};
+      if (CERT_GetCertTrust(node->cert, &trust) == SECSuccess) {
+        ++trustReadable;
+        if (certCount <= 3) {
+          MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+                  ("[LOWLAND_NSS_ROOTS] cert=%u sslFlags=0x%x", certCount,
+                   trust.sslFlags));
+        }
+        if (trust.sslFlags & CERTDB_TRUSTED_CA) {
+          ++sslTrusted;
+        }
+      }
+    }
+  }
+  MOZ_LOG(gPIPNSSLog, LogLevel::Error,
+          ("[LOWLAND_NSS_ROOTS] list=%d certs=%u trust=%u sslCA=%u",
+           certs ? 1 : 0, certCount, trustReadable, sslTrusted));
+  // A single trusted root does not mean bootstrap finished. Snapshot native
+  // trust objects before making changes, preserving explicit user trust and
+  // distrust decisions, including records with zero CERTCertTrust flags.
+  UniquePK11SlotInfo profileSlot(PK11_GetInternalKeySlot());
+  if (!profileSlot) {
+    return NS_ERROR_FAILURE;
+  }
+  PR_SetError(0, 0);
+  PK11GenericObject* nativeObjects =
+      PK11_FindGenericObjects(profileSlot.get(), CKO_NSS_TRUST);
+  if (!nativeObjects && PR_GetError()) {
+    return NS_ERROR_FAILURE;
+  }
+  auto releaseObjects = MakeScopeExit([&] {
+    if (nativeObjects) PK11_DestroyGenericObjects(nativeObjects);
+  });
+  nsTArray<nsCString> nativeTrustHashes;
+  for (auto* object = nativeObjects; object;
+       object = PK11_GetNextGenericObject(object)) {
+    ScopedAutoSECItem hash;
+    if (PK11_ReadRawAttribute(PK11_TypeGeneric, object, CKA_CERT_SHA1_HASH,
+                             &hash) != SECSuccess || hash.len != 20) {
+      return NS_ERROR_FAILURE;
+    }
+    nativeTrustHashes.AppendElement(nsCString(
+        reinterpret_cast<const char*>(hash.data), hash.len));
+  }
+  // Host-created SQL trust objects are not read as trusted by this Wasm NSS.
+  // Reapply trust inside the target only to CA certificates deliberately
+  // imported into this dedicated profile from the shipped system CA bundle.
+  unsigned eligible = 0;
+  unsigned updated = 0;
+  unsigned preserved = 0;
+  int firstError = 0;
+  if (certs) {
+    for (CERTCertListNode* node = CERT_LIST_HEAD(certs.get());
+         !CERT_LIST_END(node, certs.get()); node = CERT_LIST_NEXT(node)) {
+      const char* nickname = node->cert->nickname;
+      const char* label = nickname ? strrchr(nickname, ':') : nullptr;
+      label = label ? label + 1 : nickname;
+      if (!label || strncmp(label, "lowland-ca-", 11) != 0 ||
+          !CERT_IsCACert(node->cert, nullptr)) {
+        continue;
+      }
+      ++eligible;
+      // SHA-1 is the NSS trust-object lookup key, not a signature policy.
+      unsigned char digest[20];
+      if (PK11_HashBuf(SEC_OID_SHA1, digest, node->cert->derCert.data,
+                       node->cert->derCert.len) != SECSuccess) {
+        if (!firstError) firstError = PR_GetError();
+        continue;
+      }
+      if (nativeTrustHashes.Contains(nsDependentCSubstring(
+              reinterpret_cast<const char*>(digest), sizeof(digest)))) {
+        ++preserved;
+        continue;
+      }
+      CERTCertTrust wanted = {};
+      if (CERT_DecodeTrustString(&wanted, "C,,") != SECSuccess ||
+          CERT_ChangeCertTrust(nullptr, node->cert, &wanted) != SECSuccess) {
+        if (!firstError) firstError = PR_GetError();
+        continue;
+      }
+      CERTCertTrust actual = {};
+      if (CERT_GetCertTrust(node->cert, &actual) == SECSuccess &&
+          (actual.sslFlags & CERTDB_TRUSTED_CA)) {
+        ++updated;
+      } else if (!firstError) {
+        firstError = PR_GetError();
+      }
+    }
+  }
+  MOZ_LOG(gPIPNSSLog, LogLevel::Error,
+          ("[LOWLAND_NSS_ROOTS] target trust eligible=%u updated=%u preserved=%u error=%d",
+           eligible, updated, preserved, firstError));
+  if (eligible && eligible == updated + preserved) {
+    return NS_OK;
+  }
+  MOZ_LOG(gPIPNSSLog, LogLevel::Error,
+          ("[LOWLAND_NSS_ROOTS] no SSL-trusted profile CA"));
+#endif
   MOZ_LOG(gPIPNSSLog, LogLevel::Debug, ("could not load loadable roots"));
   return NS_ERROR_FAILURE;
 }
