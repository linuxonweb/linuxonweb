{
  "name": "linuxwasm",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "RELEASE_REPO": "linuxonweb/linuxonweb" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
